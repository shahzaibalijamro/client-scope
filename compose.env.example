# Copy this file to compose.env and replace the placeholders.
# MongoDB remains external; Compose intentionally defines no database service.
NODE_ENV=development
MONGODB_URI=mongodb://host.docker.internal:27017/clientscope
FRONTEND_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_THROTTLE_LIMIT=12
EMAIL_DELIVERY_MODE=local
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=ClientScope
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=30000
PRIVATE_ASSET_STORAGE_MODE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
DEMO_MODE_ENABLED=false
DEMO_TENANT_ID=
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=
DEMO_APPROVER_EMAIL=
DEMO_APPROVER_PASSWORD=
DEMO_RESET_SECRET=
DEMO_CLOUDINARY_FOLDER=clientscope-demo/local
DEMO_EMAILS_PER_USER_HOUR=3
DEMO_AI_REQUESTS_PER_USER_HOUR=10
DEMO_UPLOAD_MIB_PER_USER_HOUR=20
DEMO_EMAILS_PER_DAY=30
DEMO_AI_REQUESTS_PER_DAY=100
DEMO_UPLOAD_MIB_PER_DAY=250
