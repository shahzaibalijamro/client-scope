# Server-only Express origin used by the Next.js same-origin /api proxy.
# Do not prefix this variable with NEXT_PUBLIC_.
BACKEND_API_ORIGIN=http://127.0.0.1:4000

# Server-only trusted public origin for canonical URLs and sharing metadata.
# HTTPS is required in production; never derive this value from request headers.
FRONTEND_ORIGIN=http://localhost:3000
# Only local production containers may opt into HTTP on a loopback hostname.
PUBLIC_ORIGIN_MODE=production
