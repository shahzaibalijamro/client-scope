# Runtime mode: development, test, or production.
NODE_ENV=development

# Local Express port. The frontend example expects port 4000.
PORT=4000

# Use a developer-owned database. Never commit real credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/clientscope

# Browser/session boundary.
FRONTEND_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_THROTTLE_LIMIT=12

# Local tests use the fake provider. For Gmail delivery, use a Google App Password,
# never the Google account's normal password.
EMAIL_DELIVERY_MODE=local
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=replace-with-16-character-google-app-password
EMAIL_FROM_NAME=ClientScope

# Never enable outside an isolated local Playwright run.
E2E_TEST_MODE=0
