exports[`transactional email presentation > renders deterministic multipart access-removal with equivalent content and destinations 1`] = `
{
  "category": "access-removal",
  "html": "<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title>Access ended — ClientScope</title></head>
<body style="margin:0;padding:0;background-color:#f8fafc;color:#0f172a;font-family:Arial,Helvetica,sans-serif;line-height:1.6;">
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">Your access has ended — ClientScope</div>
<table role="presentation" style="width:100%;border-collapse:collapse;background-color:#f8fafc;"><tr><td style="padding:24px 12px;">
<table role="presentation" style="width:100%;max-width:600px;margin:0 auto;border-collapse:collapse;background-color:#ffffff;border:1px solid #e2e8f0;"><tr><td style="padding:28px;overflow-wrap:anywhere;word-break:break-word;">
<p style="margin:0 0 26px;font-size:22px;font-weight:bold;color:#4338ca;">ClientScope</p>
<h1 style="margin:0 0 18px;font-size:25px;line-height:1.3;color:#0f172a;">Your access has ended</h1>
<p style="margin:0 0 24px;font-size:16px;">Your access to Northstar website has ended.</p>
<p style="margin:0 0 24px;"><a href="https://clientscope.example/work" style="display:inline-block;background-color:#4338ca;border:1px solid #4338ca;border-radius:6px;padding:13px 20px;color:#ffffff;font-weight:bold;text-decoration:none;">Open My Work</a></p>
<p style="font-size:13px;color:#475569;margin:0 0 6px;">If the button is unavailable, open this link:</p>
<p style="font-size:13px;margin:0 0 24px;word-break:break-all;"><a href="https://clientscope.example/work" style="color:#3730a3;text-decoration:underline;">https://clientscope.example/work</a></p>
<p style="margin:0;font-size:14px;color:#475569;">Sign in to ClientScope to see the current record. Access and decision authority are checked against your current membership; this email does not grant access or approval rights.</p>
<hr style="border:0;border-top:1px solid #e2e8f0;margin:28px 0 18px;">
<p style="margin:0;font-size:12px;color:#475569;">ClientScope — Clear work. Clear decisions.<br>This is a transactional account or project notification.</p>
</td></tr></table></td></tr></table></body></html>",
  "subject": "Access ended — ClientScope",
  "text": "ClientScope

Your access has ended

Your access to Northstar website has ended.

Open My Work:
https://clientscope.example/work

Sign in to ClientScope to see the current record. Access and decision authority are checked against your current membership; this email does not grant access or approval rights.

ClientScope — Clear work. Clear decisions.
This is a transactional account or project notification.",
  "to": "recipient@example.com",
}
`;

