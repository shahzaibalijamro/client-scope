<table role="presentation" style="width:100%;max-width:600px;margin:0 auto;border-collapse:collapse;background-color:#ffffff;border:1px solid #e2e8f0;"><tr><td style="padding:28px;overflow-wrap:anywhere;word-break:break-word;">
<p style="margin:0 0 26px;font-size:22px;font-weight:bold;color:#4338ca;">ClientScope</p>
<h1 style="margin:0 0 18px;font-size:25px;line-height:1.3;color:#0f172a;">Your account is already available</h1>
<p style="margin:0 0 24px;font-size:16px;">An account already exists for this email address. Sign in, or use Forgot password on the sign-in page to request a reset.</p>
<p style="margin:0 0 24px;"><a href="https://clientscope.example/sign-in" style="display:inline-block;background-color:#4338ca;border:1px solid #4338ca;border-radius:6px;padding:13px 20px;color:#ffffff;font-weight:bold;text-decoration:none;">Sign in</a></p>
